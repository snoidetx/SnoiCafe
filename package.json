{
  "name": "snoicafe",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests docs *.md *.json *.ts *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "heic-to": "1.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
