# Supabase Dashboard → Settings → API. Only the PUBLIC/publishable key belongs here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Local development: /. GitHub project Pages: /SnoiCafe/
VITE_BASE_PATH=/
# Never put a service-role key, database password, or SMTP secret in a VITE_ variable.
# Kitchen codes and chef passwords belong in the database, never in this file.
